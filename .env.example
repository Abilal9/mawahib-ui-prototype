# =============================================================================
# Mawahib frontend (Expo) — public environment variables
# =============================================================================
# Copy to `.env` for local secrets (gitignored). Never put SERVER secrets here:
#   SUPABASE_SECRET_KEY, DATABASE_URL, JWT secrets, service_role keys.
#
# Nest API base URL is NOT configured by editing this file for day-to-day work.
# Use npm scripts (they set EXPO_PUBLIC_API_URL; app.config.js resolves it):
#   npm run start:local    → http://localhost:3000/api/v1
#   npm run start:railway  → https://mawahib-backend-production.up.railway.app/api/v1
#
# Do not put EXPO_PUBLIC_API_URL in `.env` / `.env.development` / `.env.local`
# for switching backends — Expo's client dotenv merge would fight the scripts.
# See docs/API_ENV.md.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (client) — REQUIRED for Auth
# -----------------------------------------------------------------------------
# Dashboard → Project Settings → API → Project URL / Publishable (anon) key
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# -----------------------------------------------------------------------------
# Nest API — set by npm scripts / CI (do not rely on this file for switching)
# -----------------------------------------------------------------------------
# EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# -----------------------------------------------------------------------------
# Feature flags
# -----------------------------------------------------------------------------
# Set true only after Supabase Phone Auth + SMS provider are configured.
EXPO_PUBLIC_PHONE_AUTH_ENABLED=false

# Auth session persistence uses expo-sqlite localStorage (see src/lib/supabase.ts).
# Do not reintroduce @react-native-async-storage/async-storage for Supabase Auth on Expo SDK 57.
#
# Deep link scheme: mawahib://auth/callback — see docs/AUTH.md for Supabase Redirect URLs.
#
# After changing EXPO_PUBLIC_* values, restart Metro with a clean cache:
#   npx expo start -c
